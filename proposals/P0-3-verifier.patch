+import { describe, it, expect } from "vitest";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { makeFixtureRepo } from "./helpers.js";
+import { runCascade } from "../src/verify/cascade.js";
+import { CascadeVerifier } from "../src/verify/verifier.js";
+import { DEFAULT_CONFIG } from "../src/config.js";
+
+describe("human-owned verifier (I-4)", () => {
+  it("runCascade reports skipped stages as ok:false and passes only if a stage ran", async () => {
+    const empty = fs.mkdtempSync(path.join(os.tmpdir(), "tfa-empty-"));
+    const r = await runCascade(empty, DEFAULT_CONFIG);
+    expect(r.ok).toBe(false);
+    expect(r.stages.every((s) => s.skipped && !s.ok)).toBe(true);
+  });
+
+  it("CascadeVerifier verifies the fixture fix and keeps the edit", async () => {
+    const repo = makeFixtureRepo();
+    const r = await new CascadeVerifier(DEFAULT_CONFIG).run(
+      { id: "cand_V", subtaskId: "sub_V", createdBy: "worker", edits: [{ path: "src/price.ts", find: "const t: string = total(items);", replace: "const t: number = total(items);" }] },
+      repo,
+    );
+    expect(r.ok).toBe(true);
+    expect(r.stages.find((s) => s.stage === "typecheck")).toMatchObject({ ok: true });
+    expect(r.stages.filter((s) => s.skipped).every((s) => !s.ok)).toBe(true);
+  }, 120_000);
+});
